# Default configuration for scRNA-seq Analysis Agent
# Copy this file to .env and fill in your API keys

# ============================================================
# LLM API Keys (at least one required)
# ============================================================

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional, for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# NCBI/Entrez API (required for Literature RAG)
# ============================================================

# Your email for NCBI Entrez (required)
EMAIL1=your_email@example.com

# NCBI API Key (optional but recommended for higher rate limits)
# Get one at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY1=your_ncbi_api_key_here

# ============================================================
# Model Configuration (optional overrides)
# ============================================================

# Default models for each agent type
# Options: gpt-4o, gpt-4o-mini, claude-3-opus, claude-3-sonnet, etc.
# MODEL_PIPELINE=gpt-4o
# MODEL_COORDINATOR=gpt-4o
# MODEL_SPECIALIST=gpt-4o-mini

# ============================================================
# Output Configuration
# ============================================================

# Default output directory
OUTPUT_DIR=./output

# Whether to save intermediate results
SAVE_INTERMEDIATES=true

# ============================================================
# Advanced Settings
# ============================================================

# Maximum epochs for scVI training
SCVI_MAX_EPOCHS=400

# Maximum epochs for scANVI fine-tuning
SCANVI_MAX_EPOCHS=100

# Number of latent dimensions
N_LATENT=30
